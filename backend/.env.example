# --- Core ---
# Postgres in production/docker; falls back to SQLite for quick local dev if unset
DATABASE_URL=postgresql://weta:weta@localhost:5432/weta_crm
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend, used for links in emails (welcome, password reset).
# Falls back to the first CORS origin when unset — set it in production, e.g. https://crm.wetano.com
APP_URL=

# Seeded on first boot if no users exist
ADMIN_EMAIL=admin@wetacrm.com
ADMIN_PASSWORD=admin123

# --- Optional infrastructure (all degrade gracefully when unset) ---
# Celery / background jobs (tasks run inline when unset)
REDIS_URL=redis://localhost:6379/0

# Global search (falls back to SQL search when unset)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# File storage (falls back to local ./uploads when unset)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=weta-crm
MINIO_SECURE=false

# Email (logs to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WeTa CRM <no-reply@weta.local>

