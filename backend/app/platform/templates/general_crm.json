    "notification_settings": {
      "email_on_lead_assign": true,
      "email_on_task_assign": true
    },
    "quotation_template": {
      "title": "QUOTATION",
      "number_prefix": "QT",
      "accent_color": "#4F46E5",
      "layout": "modern",
      "font": "helvetica",
      "label_item": "Item & Description",
      "label_quantity": "Qty",
      "label_rate": "Rate",
      "label_tax": "Tax %",
      "label_amount": "Amount",
      "show_tax_column": true,
      "show_signature": true,
      "show_logo": true,
      "signature_label": "Authorized Signatory",
      "bank_details": "",
      "footer_note": "Thank you for your business.",
      "default_terms": "This quotation is valid for 30 days from the issue date."
    },
    "invoice_template": {
      "title": "INVOICE",
      "number_prefix": "INV",
      "accent_color": "#4F46E5",
      "layout": "modern",
      "font": "helvetica",
      "label_item": "Item & Description",
      "label_quantity": "Qty",
      "label_rate": "Rate",
      "label_tax": "Tax %",
      "label_amount": "Amount",
      "show_tax_column": true,
      "show_signature": true,
      "show_logo": true,
      "signature_label": "Authorized Signatory",
      "bank_details": "",
      "footer_note": "Thank you for your business.",
      "default_notes": ""
    },
    "features": {
      "poster_studio": false
    }
  },
  "email_templates": [
    {
      "name": "welcome",
      "subject": "Welcome to {app_name}",
      "body_html": "<div style=\"font-family:Arial,Helvetica,sans-serif;color:#0f172a;line-height:1.6\">{logo_html}<p>Hi {first_name},</p><p>Your <b>{app_name}</b> account is ready. Sign in with <b>{email}</b>.</p><p style=\"margin:22px 0\"><a href=\"{app_url}\" style=\"display:inline-block;background:#4F46E5;color:#ffffff;text-decoration:none;padding:11px 22px;border-radius:8px;font-weight:600\">Open {app_name}</a></p><p style=\"color:#64748b;font-size:13px\">Or paste this link into your browser: <a href=\"{app_url}\" style=\"color:#4F46E5\">{app_url}</a></p></div>",
      "description": "Sent when a new user account is created",
      "trigger": "welcome",
      "enabled": true
    },
    {
      "name": "password_reset",
      "subject": "Reset your {app_name} password",
      "body_html": "<p>Hi {first_name},</p><p>Use this link to reset your password: <a href='{reset_link}'>Reset password</a>. It expires in 30 minutes.</p>",
      "description": "Password reset link",
      "trigger": "password_reset",
      "enabled": true
    },
    {
      "name": "lead_assigned",
      "subject": "New lead assigned: {lead_title}",
      "body_html": "<p>Hi {first_name},</p><p>The lead <b>{lead_title}</b> has been assigned to you.</p>",
      "description": "Sent when a lead is assigned to a user",
      "trigger": "lead_assigned",
      "enabled": true
    },
    {
      "name": "quotation",
      "subject": "Quotation {number} from {company_name}",
      "body_html": "<p>Dear {contact_name},</p><p>Please find attached quotation <b>{number}</b> totalling <b>{total}</b>.</p>",
      "description": "Sent with a quotation PDF",
      "trigger": "quotation",
      "enabled": true
    }
  ],
  "masters": {}
