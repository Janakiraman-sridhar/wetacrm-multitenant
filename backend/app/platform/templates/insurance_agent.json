    {
      "name": "Payment pending",
      "order": 6,
      "probability": 90,
      "is_won": false,
      "is_lost": false
    },
    {
      "name": "Policy issued",
      "order": 7,
      "probability": 100,
      "is_won": true,
      "is_lost": false
    },
    {
      "name": "Lost",
      "order": 8,
      "probability": 0,
      "is_won": false,
      "is_lost": true
    }
