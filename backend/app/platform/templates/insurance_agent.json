  "stages": [
    {
      "name": "New enquiry",
      "order": 1,
      "probability": 10,
      "is_won": false,
      "is_lost": false
    },
    {
      "name": "Contacted",
      "order": 2,
      "probability": 25,
      "is_won": false,
      "is_lost": false
    },
    {
      "name": "Quote shared",
      "order": 3,
      "probability": 45,
      "is_won": false,
      "is_lost": false
