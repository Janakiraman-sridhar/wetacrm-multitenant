# Copy to the repository root as `.env` before `docker compose up`.
#
# Generate every secret below rather than editing the placeholders by hand:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Compose refuses to start if JWT_SECRET, PII_MASTER_KEY or ADMIN_PASSWORD is
# missing. That is deliberate: a deployment silently running on a placeholder
# secret is worse than one that will not start.

# --- the one you must not lose -----------------------------------------------
# Wraps every tenant's data-encryption key, which in turn encrypts PAN and
# Aadhaar. Lose it and that data is permanently unreadable — there is no
# recovery path and no reset. Leak it and the encryption is undone.
# Back it up somewhere separate from the database backups: a copy of the
# database and a copy of this key in the same place is a copy of the plaintext.
PII_MASTER_KEY=

POSTGRES_USER=weta
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=weta_crm

JWT_SECRET=
# Your real frontend origin(s). Also used as the fallback for email links.
CORS_ORIGINS=https://crm.wetano.com
# Public URL of the app, used for links in emails (welcome, password reset).
# Leave blank to fall back to the first CORS origin above.
APP_URL=https://crm.wetano.com

ADMIN_EMAIL=admin@wetacrm.com
# The first platform Super Admin. Change it at first sign-in.
ADMIN_PASSWORD=

MEILI_MASTER_KEY=change-me-meili-key
MINIO_ROOT_USER=weta-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WeTa CRM <no-reply@wetacrm.com>
