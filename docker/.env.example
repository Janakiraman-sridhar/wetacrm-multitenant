# Copy to the repository root as `.env` before `docker compose up`.
POSTGRES_USER=weta
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=weta_crm

JWT_SECRET=change-me-to-a-long-random-string
# Your real frontend origin(s). Also used as the fallback for email links.
CORS_ORIGINS=https://crm.wetano.com
# Public URL of the app, used for links in emails (welcome, password reset).
# Leave blank to fall back to the first CORS origin above.
APP_URL=https://crm.wetano.com

ADMIN_EMAIL=admin@wetacrm.com
ADMIN_PASSWORD=change-me-admin-password

MEILI_MASTER_KEY=change-me-meili-key
MINIO_ROOT_USER=weta-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WeTa CRM <no-reply@wetacrm.com>
